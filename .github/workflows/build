name: Build WPF Paint

on:
  push:
    branches: [main]
  workflow_dispatch:

jobs:
  build:
    runs-on: windows-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '8.0.x'

      - name: Build WPF
        run: dotnet build WPF-Paint.csproj -c Release

      - name: Upload files
        uses: actions/upload-artifact@v4
        with:
          name: WPF-Paint
          path: bin/Release/**/*.exe
